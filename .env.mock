# Mock mode: `bun run start:mock`
#
# Runs the app against a fake comma backend served by the dev server, so every
# feature works with no paired device and no comma account. See config/mock/.
#
# Scenarios: default | nodevice | noprime | body | anonymous
#   default    prime device with a couple weeks of drives
#   nodevice   signed in, nothing paired (pair-a-device flow)
#   noprime    device without a subscription (prime checkout)
#   body       comma body, so /stream teleop renders
#   anonymous  signed out (landing page)
VITE_MOCK_API=true
VITE_MOCK_SCENARIO=default

VITE_APP_DEVTOOLS=1

# Point the API clients at the dev server's mock middleware.
VITE_COMMA_URL_ROOT=/__mock/api/
VITE_ATHENA_URL_ROOT=/__mock/athena/
VITE_BILLING_URL_ROOT=/__mock/billing/

# Left pointing at the real service: it is only ever used to build outbound links.
VITE_USERADMIN_URL_ROOT=https://useradmin.comma.ai/
