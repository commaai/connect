{
  "name": "connect",
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "start:mock": "vite --mode mock",
    "build:development": "vite build --mode development",
    "build:production": "vite build",
    "build:gallery": "bun add --no-save --trust puppeteer@24.16.0 pixelmatch@7.1.0 pngjs@7.0.0 && node scripts/build-gallery.mjs",
    "serve": "vite preview",
    "lint": "oxlint src && bun run check",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "check": "svelte-kit sync && svelte-check --fail-on-warnings",
    "test-watch": "vitest"
  },
  "repository": "https://github.com/commaai/connect.git",
  "author": "Chris Vickery <chrisinajar@gmail.com>",
  "contributors": [
    "Joost Wooning <jwooning@gmail.com>",
    "Chris Vickery <chrisinajar@gmail.com>",
    "Cameron Clough <cameronjclough@gmail.com>"
  ],
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=16",
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@commaai/my-comma-auth": "^1.4.1",
    "@mapbox/mapbox-sdk": "^0.15.3",
    "@sentry/browser": "^10.69.0",
    "@sentry/vite-plugin": "^2.7.0",
    "barcode-detector": "^3.0.8",
    "dayjs": "^1.11.9",
    "jwt-decode": "^3.1.2",
    "localforage": "^1.10.0",
    "mapbox-gl": "^1.13.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxlint": "^1.73.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4",
    "typescript": "~5.9",
    "vite": "^5",
    "vitest": "^4.1.10",
    "whatwg-fetch": "^3.6.17"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "trustedDependencies": [
    "@sentry/cli",
    "@swc/core",
    "core-js",
    "jss"
  ]
}
